# VitaScan – minden Docker Compose és kapcsolódó szolgáltatás változója egy helyen.
# Ne legyen külön .env a web/db-admin-stack mappában – ez a fájl a forrás.
#
# ─── PostgreSQL (külső konténer: global_postgres, hálózat: global-net) ────────
DB_USER=vitascan
DB_PASS=changeme
DB_NAME=vitascan_db

# ─── API JWT ──────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=replace-with-long-random-string
JWT_REFRESH_SECRET=replace-with-long-random-string

# ─── API ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3005

# ─── Gemini (napi AI elemzés) ─────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Rate limit / quota esetén automatikus váltás
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# ─── Receptképek (API + db-tools közös volume: /data/vitascan/recipes) ────────
# A kézi / ütemezett mentés .tar.gz csomagja tartalmazza a database.dump-ot és a receptképeket.
RECIPE_STORAGE_DIR=/data/vitascan/recipes

# ─── USDA FoodData Central (ételkeresés) ──────────────────────────────────────
USDA_API_KEY=

# ─── Web (SPA build-time – same-origin /api, nginx proxizza az API-ra) ────────
VITE_API_URL=/api
# Host port a web konténerhez (8080 gyakran foglalt – alapértelmezés a compose-ban: 9080)
WEB_PORT=9080

# ─── Prisma Studio ────────────────────────────────────────────────────────────
PRISMA_STUDIO_PORT=5555

# ─── Adatbázis mentés (db-tools) – kötelező élesben erős érték ─────────────────
# Az API és a db-tools konténernek ugyanaz kell legyen. Ne legyen üres érték (DB_TOOLS_SECRET= ) – akkor az alapértelmezés nem érvényesül.
DB_TOOLS_SECRET=changeme-generate-strong-db-tools-secret

# Belső Docker DNS név; ritkán kell felülírni.
DB_TOOLS_URL=http://db-tools:3010

# db-tools: PostgreSQL kliens (pg_dump/pg_restore) főverziója.
# • Érdemes egyeztetni a global_postgres szerver főverziójával (pl. transaction_timeout / egyéb SET).
# • A custom .dump fájlt legalább akkora főverziójú pg_restore-rel kell nyitni, mint amivel készült:
#   „unsupported version (1.16) in file header” → a mentés PG 17-es pg_dump-pal készült → PG_MAJOR=17 (vagy újabb).
PG_MAJOR=17

# db-tools konténer belső útvonalai (általában nem kell módosítani)
# DB_TOOLS_BACKUP_DIR=/backups
# DB_TOOLS_SCHEDULE_FILE=/config/schedule.json

# Google Drive feltöltés (rclone) – mentés után. Alapból ki.
# Setup: web/db-admin-stack/rclone/README.md
RCLONE_UPLOAD_ENABLED=false
# RCLONE_REMOTE=gdrive:VitaScan/backups
# RCLONE_CONFIG=/rclone/rclone.conf

# ─── Web Push (VAPID) ─────────────────────────────────────────────────────────
# Generálás: npx web-push generate-vapid-keys
# A PWA a public key-t a GET /api/notifications/vapid-public-ból kéri (build-time kulcs nem kötelező).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
