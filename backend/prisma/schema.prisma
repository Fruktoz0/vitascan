// VitaScan - Prisma Schema
// PostgreSQL adatbázis, Docker konténerben fut

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id           String @id @default(uuid())
  username     String @unique
  email        String @unique
  passwordHash String // Argon2id
  reputation   Int    @default(0)
  role         Role   @default(USER)

  logs          DailyLog[]
  createdFoods  Food[]
  foodEdits     FoodEditLog[]
  votes         Vote[]
  favorites     FoodFavorite[]
  profile       UserProfile?
  refreshTokens RefreshToken[]
  waterLogs     WaterLog[]
  weightLogs    WeightLog[]
  dayNotes      DayNote[]
  dailyAnalyses DailyAnalysis[]
  aiFoodRecognitions AiFoodRecognition[]
  createdRecipes     Recipe[]          @relation("RecipeCreator")
  recipeFavorites    RecipeFavorite[]
  aiRecipeImports    AiRecipeImport[]
  bodyMeasurementLogs BodyMeasurementLog[]
  bodyMeasurementGoals BodyMeasurementGoal[]
  bodyFatLogs          BodyFatLog[]
  bodyFatGoal          BodyFatGoal?
  aiBodyAnalyses AiBodyAnalysis[]
  workoutLogs     WorkoutLog[]
  dailyStepLogs   DailyStepLog[]
  mealTemplates   MealTemplate[]
  sharesOwned     DataShare[]    @relation("ShareOwner")
  sharesReceived  DataShare[]    @relation("SharePartner")
  shoppingLists   ShoppingList[]
  notificationPref   NotificationPref?
  pushSubscriptions  PushSubscription[]
  fastSessions       FastSession[]

  deletedAt DateTime? // Soft delete (GDPR - 30 napos türelmi idő)
  createdAt DateTime  @default(now())
}

model UserProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  birthYear        Int?
  heightCm         Float?
  weightKg         Float?
  gender           Gender?
  activityLevel    ActivityLevel @default(SEDENTARY)
  goal             Goal          @default(MAINTAIN)
  targetWeightKg   Float? // cél testsúly (kg)
  goalWeeks        Int? // opcionális: hány hét alatt szeretné elérni (null = nincs megadva)
  dailyKcalGoal    Float? // Kiszámított TDEE, felülírható
  dailyWaterGoalMl Int? // ml/nap, default: testsúly * 30
  dailyProteinGoal Float? // g / nap
  dailyCarbsGoal   Float? // g / nap
  dailyFatGoal     Float? // g / nap
  avatarKey        String? // DiceBear seed, pl. Felix — ingyenes választható avatar

  showHomeWaterCard   Boolean @default(true)
  showHomeStreakCard  Boolean @default(true)
  showHomeFastingCard Boolean @default(false)
  fastingProtocol     String  @default("16:8") // 16:8 | 18:6 | 20:4 | OMAD | CUSTOM
  fastingGoalMinutes  Int     @default(960)

  /** Heti kcal-javaslat a főoldalon (Menü → Főoldal kártyái). */
  kcalGoalFollowsWeight Boolean @default(true)
  /** AUTO = számított / elfogadott javaslat; MANUAL = kézzel átírt kcal. */
  kcalGoalSource String @default("AUTO")
  goalStartedAt  DateTime?
  startWeightKg  Float?
  /** ISO hét kulcs, pl. 2026-W34 — a „Később” erre a hétre elrejti a kártyát. */
  kcalGoalSuggestionDismissedWeek String?

  // FitnessSyncer OAuth (per-user Personal Application credentials + tokens)
  fsClientId             String?
  fsClientSecretEnc      String? // AES-GCM
  fsAccessTokenEnc       String?
  fsRefreshTokenEnc      String?
  fsTokenExpiresAt       DateTime?
  fsConnectedAt          DateTime?
  fsLastSyncAt           DateTime?
  fsStatus               FitnessSyncerStatus @default(DISCONNECTED)
  fsLastError            String?
  /** Pending OAuth PKCE (cleared after callback). */
  fsOauthState           String?
  fsOauthCodeVerifier    String?
  fsOauthStateExpiresAt  DateTime?

  tier Tier @default(FREE) // Freemium
}

/** Workout session — FitnessSyncer sync or manual. */
model WorkoutLog {
  id               String         @id @default(uuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  activityType     String
  title            String?
  startedAt        DateTime
  endedAt          DateTime?
  durationMin      Float
  activeEnergyKcal Float?
  distanceKm       Float?
  steps            Int?
  avgHeartrate     Int?
  minHeartrate     Int?
  maxHeartrate     Int?
  restingHeartrate Int?
  pace             Float?
  speedAvg         Float?
  speedMax         Float?
  elevationGain    Float?
  elevationMin     Float?
  elevationMax     Float?
  floorsClimbed    Int?
  vo2Max           Int?
  respiratoryRate  Float?
  mindfulMinutes   Int?
  avgStressLevel   Int?
  providerType     String?
  /** Downsampled HR series: [{ tMs, bpm }, ...] from GPS points. */
  hrSeries         Json?
  source           FitnessSource  @default(MANUAL)
  /** FitnessSyncer itemId (or other client id) for dedupe. */
  externalId       String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([userId, externalId])
  @@index([userId, startedAt])
}

/** Daily step count — FitnessSyncer daily summary or manual. */
model DailyStepLog {
  id         String        @id @default(uuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  steps      Int
  loggedDate DateTime      @db.Date
  source     FitnessSource @default(MANUAL)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@unique([userId, loggedDate])
  @@index([userId, loggedDate])
}

model Food {
  id          String  @id @default(uuid())
  name        String
  nameHu      String?
  nameEn      String?
  brand       String?
  barcode     String? @unique
  // Külső forrás dedup: pl. off:3017620422003, usda:173410
  externalId  String? @unique
  kcal        Float
  protein     Float // g / 100g
  carbs       Float // g / 100g
  fat         Float // g / 100g
  fiber       Float? // g / 100g (rost)
  sugar       Float? // g / 100g (cukor)
  servingSize Float? // pl. 30 (gramm)
  servingUnit String? // pl. 'adag', 'db', 'ek'

  /** Több hozzávalóból álló kész étel / recept. */
  isPrepared Boolean @default(false)

  status Status @default(UNVERIFIED)
  tier   Tier   @default(FREE) // Freemium
  source FoodSource @default(USER_SCAN)

  creatorId String
  creator   User   @relation(fields: [creatorId], references: [id])
  votes     Vote[]
  favorites FoodFavorite[]
  logs      DailyLog[]
  editLogs  FoodEditLog[]
  components FoodComponent[]
  sourcedLogs DailyLog[] @relation("PreparedFoodSource")
  templateItems MealTemplateItem[] @relation("TemplateItemFood")
  templatePreparedItems MealTemplateItem[] @relation("TemplatePreparedFood")
  recipeIngredients RecipeIngredient[]
  /** Receptből materializált prepared Food — ne jelenjen meg ételkeresésben. */
  preparedFromRecipeId String? @unique
  preparedFromRecipe   Recipe? @relation("RecipeMaterializedFood", fields: [preparedFromRecipeId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
}

/** Kész étel / recept hozzávalója (abszolút makrók az amountG-re). */
model FoodComponent {
  id        String @id @default(uuid())
  foodId    String
  food      Food   @relation(fields: [foodId], references: [id], onDelete: Cascade)
  name      String
  amountG   Float
  kcal      Float
  protein   Float
  carbs     Float
  fat       Float
  fiber     Float?
  sugar     Float?
  sortOrder Int    @default(0)

  @@index([foodId])
}

/** Közösségi termékadat-szerkesztés naplója (ki + mikor). */
model FoodEditLog {
  id        String   @id @default(uuid())
  foodId    String
  food      Food     @relation(fields: [foodId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([foodId, createdAt])
}

model FoodFavorite {
  id        String   @id @default(uuid())
  userId    String
  foodId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  food Food @relation(fields: [foodId], references: [id], onDelete: Cascade)

  @@unique([userId, foodId])
}

model Vote {
  id    String @id @default(uuid())
  value Int // +1 (upvote) vagy -1 (downvote)

  userId String
  foodId String
  user   User   @relation(fields: [userId], references: [id])
  food   Food   @relation(fields: [foodId], references: [id])

  @@unique([userId, foodId]) // Egy user csak egyszer szavazhat egy ételre
}

model DailyLog {
  id     String @id @default(uuid())
  userId String

  foodId   String?
  food     Food?   @relation(fields: [foodId], references: [id], onDelete: SetNull)
  foodName String
  kcal     Float
  protein  Float
  carbs    Float
  fat      Float
  fiber    Float?
  sugar    Float?
  amount   Float // gramm

  mealType MealType @default(OTHER)
  source   String   @default("MANUAL") // MANUAL | SCAN | SEARCH | AI | RECIPE

  /** Azonos UUID = egy „Hozzáadás” / egy tál (hozzávalónkénti logok). */
  logGroupId String?
  /** Melyik prepared Food receptből jött (ha van). */
  sourcePreparedFoodId String?
  sourcePreparedFood   Food?   @relation("PreparedFoodSource", fields: [sourcePreparedFoodId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId, logGroupId])
  @@index([sourcePreparedFoodId])
}

model MealTemplate {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  mealType  MealType
  items     MealTemplateItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, mealType])
}

model MealTemplateItem {
  id         String @id @default(uuid())
  templateId String
  template   MealTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  foodId   String?
  food     Food?   @relation("TemplateItemFood", fields: [foodId], references: [id], onDelete: SetNull)
  foodName String
  kcal     Float
  protein  Float
  carbs    Float
  fat      Float
  fiber    Float?
  sugar    Float?
  amount   Float

  sortOrder            Int     @default(0)
  groupKey             String?
  sourcePreparedFoodId String?
  sourcePreparedFood   Food?   @relation("TemplatePreparedFood", fields: [sourcePreparedFoodId], references: [id], onDelete: SetNull)

  @@index([templateId])
}

model RefreshToken {
  id     String @id @default(uuid())
  token  String @unique
  userId String
  user   User   @relation(fields: [userId], references: [id])

  expiresAt DateTime
  revokedAt DateTime? // Token rotation / kijelentkezés

  createdAt DateTime @default(now())
}

/** Kulcs–érték rendszerbeállítások (pl. admin által szerkeszthető job paraméterek). */
model SystemSetting {
  key   String @id
  value String

  updatedAt DateTime @default(now()) @updatedAt
}

/** Napi vízfogyasztás – egy sor / user / nap (WeightLog mintára). */
model WaterLog {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  totalMl    Int      @default(0) // napi összeg ml-ben
  loggedDate DateTime @db.Date
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, loggedDate])
  @@index([userId, loggedDate])
}

model WeightLog {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  weightKg  Float
  loggedDate DateTime @db.Date
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, loggedDate])
  @@index([userId, loggedDate])
}

model FastSession {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  startedAt   DateTime
  endedAt     DateTime?
  goalMinutes Int
  protocol    String // 16:8 | 18:6 | 20:4 | OMAD | CUSTOM
  source      String @default("MANUAL") // MANUAL | FROM_LAST_MEAL

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, endedAt])
  @@index([userId, startedAt])
}

/** Napi megjegyzés — egy sor / user / nap (tünetek, közérzet). */
model DayNote {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  content    String   @db.Text
  loggedDate DateTime @db.Date
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, loggedDate])
  @@index([userId, loggedDate])
}

/** Napi AI elemzés — kind: nutrition (ételkönyvtár) | fitness (edzői napértékelés). */
model DailyAnalysis {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  loggedDate      DateTime @db.Date
  /** nutrition | fitness | coach | mealSuggest | weeklyNutrition */
  kind            String   @default("nutrition")
  content         String
  generationCount Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, loggedDate, kind])
  @@index([userId, loggedDate])
}

/** Napi AI ételfelismerés számláló — max 10 / nap. Képet NEM tárolunk. */
model AiFoodRecognition {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  loggedDate DateTime @db.Date
  count     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, loggedDate])
  @@index([userId, loggedDate])
}

/** Közös receptgyűjtemény — nem prepared Food. */
model Recipe {
  id               String            @id @default(uuid())
  title            String
  description      String?
  servings         Int               @default(1)
  instructions     Json              // string[]
  category         RecipeCategory?
  dietTags         RecipeDietTag[]   @default([])
  sourceUrl        String?
  sourceType       RecipeSourceType  @default(MANUAL)
  sourceExternalId String?
  status           RecipeStatus      @default(PENDING)
  rejectReason     String?
  createdBy        String
  creator          User              @relation("RecipeCreator", fields: [createdBy], references: [id])
  ingredients      RecipeIngredient[]
  images           RecipeImage[]
  favorites        RecipeFavorite[]
  materializedFood Food?             @relation("RecipeMaterializedFood")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([status, createdAt])
  @@index([createdBy])
  @@index([category])
  @@unique([sourceType, sourceExternalId])
}

model RecipeIngredient {
  id        String  @id @default(uuid())
  recipeId  String
  recipe    Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  foodId    String?
  food      Food?   @relation(fields: [foodId], references: [id], onDelete: SetNull)
  name      String
  amount    Float?
  unit      String?
  amountG   Float?
  matchConfidence Float?
  sortOrder Int     @default(0)

  @@index([recipeId])
  @@index([foodId])
}

model RecipeImage {
  id         String   @id @default(uuid())
  recipeId   String
  recipe     Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  storageKey String
  mimeType   String
  width      Int?
  height     Int?
  sizeBytes  Int
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([recipeId, isPrimary])
}

model RecipeFavorite {
  id        String   @id @default(uuid())
  userId    String
  recipeId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([userId, recipeId])
}

/** Napi AI receptimport számláló kind szerint (IMAGE | URL | VIDEO). */
model AiRecipeImport {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  loggedDate DateTime @db.Date
  kind       String   @default("IMAGE")
  count      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, loggedDate, kind])
  @@index([userId, loggedDate])
}

/// Testkörfogat mérés — egy érték / user / testrész / nap
model BodyMeasurementLog {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bodyPart   BodyPart
  valueCm    Float
  loggedDate DateTime @db.Date
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, bodyPart, loggedDate])
  @@index([userId, bodyPart, loggedDate])
}

model BodyMeasurementGoal {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bodyPart  BodyPart
  goalCm    Float
  updatedAt DateTime @updatedAt

  @@unique([userId, bodyPart])
}

/// Testzsír % — egy érték / user / nap
model BodyFatLog {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fatPercent Float
  loggedDate DateTime @db.Date
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, loggedDate])
  @@index([userId, loggedDate])
}

model BodyFatGoal {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  goalPercent Float
  updatedAt   DateTime @updatedAt
}

/** AI testelemzés — max 3 generálás / nap, új felülírja a régit. */
model AiBodyAnalysis {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  loggedDate      DateTime @db.Date
  content         String
  generationCount Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, loggedDate])
  @@index([userId, loggedDate])
}

/// Élő adatmegosztás egy meglévő felhasználóval (email alapján, in-app elfogadás).
model DataShare {
  id         String          @id @default(uuid())
  ownerId    String
  partnerId  String
  owner      User            @relation("ShareOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  partner    User            @relation("SharePartner", fields: [partnerId], references: [id], onDelete: Cascade)
  categories ShareCategory[]
  status     ShareStatus     @default(PENDING)
  createdAt  DateTime        @default(now())
  acceptedAt DateTime?
  revokedAt  DateTime?

  @@unique([ownerId, partnerId])
  @@index([partnerId, status])
  @@index([ownerId, status])
}

model ShoppingList {
  id        String             @id @default(uuid())
  ownerId   String
  owner     User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  items     ShoppingListItem[]

  @@index([ownerId])
}

model ShoppingListItem {
  id        String       @id @default(uuid())
  listId    String
  list      ShoppingList @relation(fields: [listId], references: [id], onDelete: Cascade)
  name      String
  qtyLabel  String?
  foodId    String?
  recipeId  String?
  checked   Boolean      @default(false)
  addedAt   DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([listId])
}

model NotificationPref {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  mealEnabled     Boolean @default(true)
  mealBreakfast   Boolean @default(true)
  mealLunch       Boolean @default(true)
  mealDinner      Boolean @default(true)
  mealSnack       Boolean @default(false)
  mealBreakfastAt String  @default("08:00")
  mealLunchAt     String  @default("12:30")
  mealDinnerAt    String  @default("18:30")
  mealSnackAt     String  @default("15:30")

  waterEnabled     Boolean @default(true)
  waterEveryHours  Int     @default(2)
  waterQuietStart  String  @default("22:00")
  waterQuietEnd    String  @default("07:00")

  dailySummaryEnabled Boolean @default(false)
  dailySummaryAt      String  @default("20:00")

  cartPartnerEnabled  Boolean @default(true)
  shareInviteEnabled  Boolean @default(true)
  fastingGoalEnabled  Boolean @default(true)

  timezone String @default("Europe/Budapest")

  lastWaterPushAt        DateTime?
  lastMealSlot           String?
  lastDailyDate          String?
  lastFastingGoalPushAt  DateTime?

  updatedAt DateTime @updatedAt
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Status {
  UNVERIFIED
  VERIFIED
  BANNED
}

enum Tier {
  FREE
  PREMIUM
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum Goal {
  LOSE
  MAINTAIN
  GAIN
}

enum MealType {
  BREAKFAST
  TIZORAI
  LUNCH
  UZSONNA
  DINNER
  SNACK
  OTHER
}

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  ACTIVE
  VERY_ACTIVE
}

enum Role {
  USER
  ADMIN
}

enum FoodSource {
  INTERNAL
  USER_SCAN
  EXTERNAL_API
}

enum BodyPart {
  ARM
  THIGH
  WAIST
  FOREARM
  HIP
  CHEST
  CALF
}

enum FitnessSource {
  SHORTCUTS
  MANUAL
  FITNESSSYNCER
}

enum FitnessSyncerStatus {
  DISCONNECTED
  CONNECTED
  ERROR
}

enum RecipeSourceType {
  MANUAL
  IMAGE
  VIDEO
  FACEBOOK
  INSTAGRAM
  TIKTOK
  YOUTUBE
  WEB
}

enum RecipeStatus {
  PENDING
  PUBLISHED
  REJECTED
}

enum RecipeCategory {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
  DESSERT
  OTHER
}

enum RecipeDietTag {
  GLUTEN_FREE
  DAIRY_FREE
  VEGAN
}

enum ShareCategory {
  FOOD
  WEIGHT
  WATER
  BODY
  CART
}

enum ShareStatus {
  PENDING
  ACTIVE
  REVOKED
}
